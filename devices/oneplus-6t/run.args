# Boot-args that xl adds to every run on this phone (unless XL_CMDLINE already gives them by name:
# XL_CMDLINE="-v cpus=1" for one core, "bootcpu=0" to stay on the core the firmware starts on).
cpus=8          # all eight cores: small 0-3 (Kryo 385 Silver), big 4-7 (Kryo 385 Gold)
bootcpu=7       # the kernel on the biggest core; the loader watches from core 0, so a kernel that hangs still gets its log out
soc_vtimer=19   # the SDM845's virtual timer interrupt (PPI 3, intid 19); without it the kernel waits for a timer that never comes
cpufreq_osm=2   # the cores' clocks raised (bsd/dev/hakios.cpufreq.c): big 825 -> 2400 MHz, small 1612 -> 1766; the home screen in 32 s, not 70
thermal=1       # the SoC's 21 temperature sensors (bsd/dev/hakios.thermal.c), read only: cores every 10 s, the most at the end
buttons=2       # power, volume up and down (bsd/dev/hakios.buttons.c, the 6T's layout): read from the PM8998, reported to SpringBoard
battery=1       # the battery through the loader (UEFI's ChargerEx and PmicDxe's fuel gauge): charge, current, temperature for the status bar
pmi_haptics=4   # the vibration motor for iOS's haptics (bsd/dev/hakios.pmi_haptics.c): taps and vibrations, from 25 s on
synaptics=3     # the touch screen (bsd/dev/hakios.synaptics.c): powered, configured, touches to SpringBoard
slider=3        # the alert slider as iOS's ring/silent switch (bsd/dev/hakios.slider.c): lower position ring, the other silent
