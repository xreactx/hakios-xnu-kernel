# Boot-args that xl adds to every run on this phone (unless XL_CMDLINE already gives them by name:
# XL_CMDLINE="-v cpus=1" for one core, "bootcpu=0" to stay on the core the firmware starts on).
cpus=8          # all eight cores: small 0-3 (Kryo 385 Silver), big 4-7 (Kryo 385 Gold)
bootcpu=7       # the kernel on the biggest core; the loader watches from core 0, so a kernel that hangs still gets its log out
soc_vtimer=19   # the SDM845's virtual timer interrupt (PPI 3, intid 19); without it the kernel waits for a timer that never comes
cpufreq_osm=2   # the cores' clocks raised (bsd/dev/hakios.cpufreq.c): big 825 -> 2400 MHz, small 1612 -> 1766; the home screen in 32 s, not 70
thermal=1       # the SoC's 21 temperature sensors (bsd/dev/hakios.thermal.c), read only: cores every 10 s, the most at the end
buttons=2       # power, volume up and down (bsd/dev/hakios.buttons.c, the 6T's layout): read from the PM8998, reported to SpringBoard
battery=1       # the battery through the loader (UEFI's ChargerEx and PmicDxe's fuel gauge): charge, current, temperature for the status bar
pmi_haptics=4   # the vibration motor for iOS's haptics (bsd/dev/hakios.pmi_haptics.c): taps and vibrations, from 25 s on
synaptics=3     # the touch screen (bsd/dev/hakios.synaptics.c): powered, configured, touches to SpringBoard
slider=3        # the alert slider as iOS's ring/silent switch (bsd/dev/hakios.slider.c): lower position ring, the other silent
adsp=1          # the audio DSP up on a thread of its own, from 25 s on (bsd/dev/hakios.adsp.c; root built ADSP=1 REST=1)
sound=4         # what iOS plays, through the speaker: QUAT MI2S and the TFA9894 (hakios.sound.c, hakios.tfa9894.c)
soc_sound_port=0x1006   # the speaker's port: QUAT_MI2S_RX ...
soc_sound_clock=0x106   # ... its bit clock, QUAD_MI2S_IBIT ...
soc_sound_bits=16       # ... at 16 bits, as Android plays it (1.536 MHz)
soc_audio_stream=0x1821 # the SMMU stream the DSP reads our memory by
soc_smem=0x86000000     # the SDM845's numbers for the audio DSP (soc.args, and the command DB AOP points at)
soc_cmd_db=0x85fe0000
soc_rsc=0x179e0000
soc_aoss=0xc300000
soc_adsp_mem=0x8c500000
soc_adsp_mem_size=0x1a00000
soc_apcs_ipc=0x1799000c
soc_adsp_cx=1
adsp_listen=5   # the DSP's hello waited for 5 s, not 1 (it once took longer: run 162746)
slim=3          # the audio SLIMbus and the WCD934x codec brought up (bsd/dev/hakios.slim.c; README step 10b)
mic=4 mic_wcd=1 # the handset microphone (AMIC4) for iOS, through SLIMBUS_0_TX (hakios.mic.c): Voice Memos records
gpu=1           # iOS draws with the Adreno 630 (bsd/dev/hakios.adreno.c, Mesa freedreno; root built GL=1 ADSP=1 REST=1)
soc_gpu=630     # ... the SDM845's GPU numbers (soc_cmd_db above gives its rails); the UEFI must be without CPRDxe (README step 9)
adreno_speed=7  # ... at its top level, 710 MHz (1 = 257): the app zooms GPU-bound at 257, 40 % of frames slow -> 28 % (runs 140417, 141106; 49 C)
fb_scan=1           # the vsync is every second scan of the panel's own (119.93 Hz), not a timer of ours: steadier swipes
ufs=2 ufs_write=1   # this kernel reads the flash itself; the one place it may write is the store at the end of system_a
var_store=1         # iOS's data volume (/private/var) kept between boots, in that store (README step 5)
