# HakiOS fragment: the OnePlus 6T (fajita, devices/fajita) -- what is true of this phone and of no other with the same SoC.
# What is turned on here has been seen working on the phone (device.conf says what and how).
CONFIG_DEVICE="fajita"
# input: the Synaptics touch screen, the PM8998's buttons (the 6T's layout), the alert slider
CONFIG_HAKIOS_SYNAPTICS=y
CONFIG_SYNAPTICS=3
CONFIG_HAKIOS_BUTTONS=y
CONFIG_BUTTONS=2
CONFIG_HAKIOS_SLIDER=y
CONFIG_SLIDER=3
# CONFIG_HAKIOS_GOODIX is not set
# the vibration motor: the PMI8998's haptics block, not redwood's
CONFIG_HAKIOS_PMI_HAPTICS=y
CONFIG_PMI_HAPTICS=4
# CONFIG_HAKIOS_HAPTIC is not set
# the battery, through the loader
CONFIG_HAKIOS_BATTERY=y
CONFIG_BATTERY=1
# CONFIG_HAKIOS_BATTGUARD is not set
# the SoC's temperatures and clocks
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_THERMAL=y
# storage: the flash read by the kernel itself; /private/var kept at the end of system_a
CONFIG_HAKIOS_UFS=y
CONFIG_UFS=2
CONFIG_UFS_WRITE=y
CONFIG_VAR_STORE=y
# the GPU at its top level; the panel through three buffers in the splash memory
CONFIG_HAKIOS_ADRENO=y
CONFIG_GPU=y
CONFIG_ADRENO_SPEED=7
CONFIG_FB_FLIP=1
CONFIG_FB_MAP_MB=30
# audio: the DSP; the loudspeaker on QUAT MI2S through the TFA9894; the earpiece and the handset microphone through the
# WCD934x (the SoC layer's SLIM); the DSP's hello waited for 5 s
CONFIG_HAKIOS_ADSP=y
CONFIG_ADSP=y
CONFIG_ADSP_LISTEN=5
CONFIG_HAKIOS_SPEAKER=y
CONFIG_HAKIOS_SOUND=y
CONFIG_SOUND=4
CONFIG_SOC_SOUND_PORT=0x1006
CONFIG_SOC_SOUND_CLOCK=0x106
CONFIG_SOC_SOUND_BITS=0x10
CONFIG_SOC_AUDIO_STREAM=0x1821
CONFIG_HAKIOS_TFA9894=y
CONFIG_SLIM=3
CONFIG_SOUND_RECEIVER=1
CONFIG_HAKIOS_MIC=y
CONFIG_MIC=4
CONFIG_MIC_WCD=1
# the modem and the Wi-Fi are built in, and started only when asked (modem_step=N; wifi6t=1: devices/fajita/README.md)
CONFIG_HAKIOS_QMI=y
CONFIG_HAKIOS_MODEM=y
CONFIG_HAKIOS_WIFI=y
# not on this phone (yet)
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_BT is not set
# the common kernel's defaults that are redwood's hardware: off here (the 6T's touch is SYNAPTICS; its modem and Wi-Fi are
# started by modem_step=N and wifi6t=1 when asked, not by modem=1 and wifi=1, which are redwood's paths)
# CONFIG_TOUCHSCREEN is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
