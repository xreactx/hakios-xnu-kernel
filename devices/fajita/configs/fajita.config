# HakiOS fragment: the OnePlus 6T (fajita, devices/fajita) -- what is true of this phone and of no other with the same SoC.
# What is turned on here has been seen working on the phone (device.conf says what and how).
CONFIG_DEVICE="fajita"
# input: the Synaptics touch screen, the PM8998's buttons (the 6T's layout), the alert slider
CONFIG_HAKIOS_SYNAPTICS=y
CONFIG_SYNAPTICS=3
CONFIG_HAKIOS_BUTTONS=y
CONFIG_BUTTONS=2
CONFIG_HAKIOS_SLIDER=y
CONFIG_SLIDER=3
# CONFIG_HAKIOS_GOODIX is not set
# the vibration motor: the PMI8998's haptics block, not redwood's
CONFIG_HAKIOS_PMI_HAPTICS=y
CONFIG_PMI_HAPTICS=4
# the battery charger: the PMI8998's SMB2; on a computer's port its input limit raised to 900 mA for the run (pmi_charger=2,
# the driver's default: no characters of the command line; pmi_charger=1 only looks, =0 leaves it alone)
CONFIG_HAKIOS_PMI_CHARGER=y
# the fuel gauge Android reads, a bq27541 on I2C (bq27541=1, the driver's default): the battery's charge for Darwin
CONFIG_HAKIOS_BQ27541=y
# CONFIG_HAKIOS_HAPTIC is not set
# the battery, through the loader
CONFIG_HAKIOS_BATTERY=y
CONFIG_BATTERY=1
# CONFIG_HAKIOS_BATTGUARD is not set
# the SoC's temperatures and clocks
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_THERMAL=y
# storage: the flash read by the kernel itself; /private/var kept at the end of system_a
CONFIG_HAKIOS_UFS=y
CONFIG_UFS=2
CONFIG_UFS_WRITE=y
CONFIG_VAR_STORE=y
# the GPU at its top level; the panel through three buffers in the splash memory
CONFIG_HAKIOS_ADRENO=y
CONFIG_GPU=y
CONFIG_ADRENO_SPEED=7
CONFIG_FB_FLIP=1
CONFIG_FB_MAP_MB=30
# audio: the DSP; the loudspeaker on QUAT MI2S through the TFA9894; the earpiece and the handset microphone through the
# WCD934x (the SoC layer's SLIM); the DSP's hello waited for 5 s
CONFIG_HAKIOS_ADSP=y
CONFIG_ADSP=y
CONFIG_ADSP_LISTEN=5
CONFIG_HAKIOS_SPEAKER=y
CONFIG_HAKIOS_SOUND=y
CONFIG_SOUND=4
CONFIG_SOC_SOUND_PORT=0x1006
CONFIG_SOC_SOUND_CLOCK=0x106
CONFIG_SOC_SOUND_BITS=0x10
CONFIG_SOC_AUDIO_STREAM=0x1821
CONFIG_HAKIOS_TFA9894=y
CONFIG_SLIM=3
CONFIG_SOUND_RECEIVER=1
CONFIG_HAKIOS_MIC=y
CONFIG_MIC=4
CONFIG_MIC_WCD=1
# the modem and the Wi-Fi: built in, and started on every run (8 November 2026, run 081127: with the GPU, the audio
# DSP and the speaker, the modem registered on LTE and the Wi-Fi joined fw-wifi/network: Safari loaded pages over it).
# The modem comes up through all eleven steps (devices/fajita/README.md, "the modem"), its regions where the 6T's
# Android has them; the Wi-Fi is ath10k on the WCN3990 (kernel built ATH=ath10k), started when the modem announces
# its firmware's service. modem=1 is all eleven steps on a thread of their own, the modem kept, no pauses (hakios.mpss.c:
# what modem_step=11 modem_keep=1 modem_pause=0 said, in fewer of the command line's 1023 characters); modem_step=N
# in XL_CMDLINE still runs it step by step. `# CONFIG_MODEM is not set` in a config of your own leaves both out.
CONFIG_HAKIOS_QMI=y
CONFIG_HAKIOS_MODEM=y
CONFIG_HAKIOS_WIFI=y
CONFIG_MODEM=y
CONFIG_MODEM_IPA_TZ=1
CONFIG_MODEM_NO_NAV=1
CONFIG_MODEM_BUFFER=0x95d00000
CONFIG_MODEM_META=0x96000000
CONFIG_SOC_MPSS_MEM=0x8e000000
CONFIG_SOC_MPSS_MEM_SIZE=0x7800000
CONFIG_SOC_MBA_MEM=0x96600000
CONFIG_SOC_MBA_MEM_SIZE=0x200000
CONFIG_WIFI6T=1
CONFIG_WIFI_JOIN=1
# Bluetooth: the WCN3990's firmware, the phone's address, and the controller handed to iOS's bluetoothd (README step 13;
# the system image built with BLUETOOTHD=1)
CONFIG_BT6T=5
# A call's voice: the WCN3990 takes and gives it by its own SLIMbus (slim@17240000), not over HCI. hakios.slim.c brings that
# bus up and hakios.mic.c bridges each voice link's PCM between bluetoothd and the DSP's SLIMBUS_7_RX/TX, at 16 kHz for the
# wideband (mSBC) links iOS makes (README step 13; run 214700: a headset's microphone recorded in Voice Memos). It is the
# drivers' default -- btslim=6, btslim_rate=16000 -- and costs no characters of the full command line; btslim=0 leaves it out.
# not on this phone (yet)
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_BT is not set
# the common kernel's defaults that are redwood's hardware: off here (the 6T's touch is SYNAPTICS; its Wi-Fi is wifi6t=1,
# ath10k, not wifi=1, redwood's ath11k path)
# CONFIG_TOUCHSCREEN is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM_AGAIN is not set
