# HakiOS fragment: the Qualcomm SDM845 -- what is true of the SoC, whatever phone it is in.
# Eight cores, the big ones 4-7 (the kernel is started on core 7, as on SC7280). The SC7280 family's drivers (cpufreq tables,
# socinfo, thermal, PMIC) are not turned on: their addresses are that family's. This one's: the SoC layer's own drivers
# (soc/drivers/: the SLIMbus and WCD934x, the WCN3990 path, tsens) and the arguments below.
CONFIG_SOC="sdm845"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
# the virtual timer's interrupt (PPI 3, intid 19: 0x13); the big cores' clocks through the older OSM
CONFIG_SOC_VTIMER=0x13
CONFIG_CPUFREQ_OSM=2
# the audio DSP: shared memory, the command DB, RPMh's sequencer, the AOP's mailbox, the DSP's memory, the APCS doorbells, CX
CONFIG_SOC_SMEM=0x86000000
CONFIG_SOC_CMD_DB=0x85fe0000
CONFIG_SOC_RSC=0x179e0000
CONFIG_SOC_AOSS=0xc300000
CONFIG_SOC_ADSP_MEM=0x8c500000
CONFIG_SOC_ADSP_MEM_SIZE=0x1a00000
CONFIG_SOC_APCS_IPC=0x1799000c
CONFIG_SOC_ADSP_CX=0x1
# the Adreno 630 (0x276), and the display controller (soc_display 845, 0x34d)'s clocks and registers at the SDM845's addresses
CONFIG_SOC_GPU=0x276
CONFIG_SOC_DISPLAY=0x34d
# the SoC's own drivers
CONFIG_HAKIOS_SLIM=y
CONFIG_HAKIOS_WIFI6T=y
CONFIG_HAKIOS_TSENS845=y
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_PMIC is not set
